# Hakoniwa settings. Copy to .env and fill in the key. .env is ignored by git.

# --- AI provider: anything that speaks the OpenAI Chat Completions API -------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Models per role ---------------------------------------------------------
# designer: turns a scenario into a world (spec + math model). Needs a strong model.
HAKONIWA_MODEL_DESIGNER=gpt-6.2-sol
HAKONIWA_EFFORT_DESIGNER=medium
# agent: residents' decisions, thoughts and speech during a run. Many small calls.
HAKONIWA_MODEL_AGENT=gpt-6-luna
HAKONIWA_EFFORT_AGENT=low
# report: the written analysis at the end of a run.
HAKONIWA_MODEL_REPORT=gpt-6.2-sol
HAKONIWA_EFFORT_REPORT=low

# Web research while designing a world: "responses" uses the OpenAI Responses API
# web_search tool; "none" lets the designer rely on its own knowledge (marked as assumptions).
HAKONIWA_RESEARCH=responses
# HAKONIWA_MODEL_RESEARCH=gpt-6.2-sol

# --- Optional ----------------------------------------------------------------
# A role can use a different provider:  HAKONIWA_AGENT_BASE_URL / HAKONIWA_AGENT_API_KEY
# HAKONIWA_LLM=mock            # force "no AI": residents follow model defaults, nothing is sent
# HAKONIWA_SANDBOX=auto        # auto | docker | remote | process
# HAKONIWA_CONCURRENCY=8       # parallel AI calls
# HAKONIWA_PORT=8787
# HAKONIWA_LANGS=en,ja         # languages residents speak in (first is the default)
